<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled State -->
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#424242" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#757575" />
                    <stroke android:width="1dp" android:color="#9E9E9E" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default Enabled State -->
    <item>
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#0D47A1" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:startColor="#2196F3" android:endColor="#4FC3F7" android:angle="90" />
                    <stroke android:width="1dp" android:color="#81D4FA" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
